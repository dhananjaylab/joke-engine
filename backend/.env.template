# App
APP_NAME="Giggle API"
DEBUG=False
SECRET_KEY=your-secret-key-change-in-production

# Database
DATABASE_URL=sqlite+aiosqlite:///./giggle.db
# For production PostgreSQL:
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/giggle

# OpenAI
OPENAI_API_KEY=your-openai-api-key-here

# Redis (optional, required for ARQ workers)
REDIS_URL=redis://localhost:6379

# CORS
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# Media
MEDIA_DIR=./media

# Cloud Storage (optional - for Cloudflare R2 or AWS S3)
USE_CLOUD_STORAGE=False
# S3_ENDPOINT_URL=https://your-account-id.r2.cloudflarestorage.com
# S3_ACCESS_KEY_ID=your-access-key-id
# S3_SECRET_ACCESS_KEY=your-secret-access-key
# S3_BUCKET_NAME=your-bucket-name
# S3_PUBLIC_URL=https://your-bucket.r2.dev

# News API (optional)
NEWSAPI_KEY=

